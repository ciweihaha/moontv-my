{
  "name": "moontv",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "npm run gen:runtime && npm run gen:manifest && next dev -H 0.0.0.0",
    "build": "npm run gen:runtime && npm run gen:manifest && TSC_COMPILE_ON_BUILD=false next build --webpack",
    "build:cf": "npm run gen:runtime && npm run gen:manifest && CF_PAGES=1 next build --webpack",
    "start": "next start",
    "lint": "eslint --no-cache src",
    "lint:fix": "eslint src --fix && npm run format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:runtime": "node scripts/convert-config.js",
    "gen:manifest": "node scripts/generate-manifest.js",
    "gen:version": "node scripts/generate-version.js",
    "postbuild": "echo 'Build completed - sitemap generation disabled'",
    "prepare": "husky",
    "pages:build": "npm run gen:runtime && npm run gen:manifest && TSC_COMPILE_ON_BUILD=false next build --webpack && npx @cloudflare/next-on-pages --experimental-minify"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@types/crypto-js": "^4.2.2",
    "artplayer": "^5.4.0",
    "bs58": "^6.0.0",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "framer-motion": "^14.10.1",
    "he": "^2.0.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.70.0",
    "media-icons": "^1.1.5",
    "next": "^16.4.5",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "sweetalert2": "^11.26.25",
    "swiper": "^14.4.0",
    "tailwind-merge": "^3.7.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bs58": "^5.0.0",
    "@types/he": "^1.2.3",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "next-router-mock": "^1.0.5",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "webpack-obfuscator": "^3.6.1",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  }
}
