# MoonTV 环境变量配置
# 部署前必读：README「环境变量」与「安全与隐私提醒」两节。

# 站点配置
SITE_NAME=MoonTV
ANNOUNCEMENT=

# 管理员账号密码
USERNAME=admin
PASSWORD=your_secure_password

# H1（必填，生产环境缺配会导致全站 503、无法登录）：
# 会话签名密钥，必须是与登录密码 PASSWORD 分离的高强度随机值；
# 修改后既有会话全部失效，用户需重新登录。
# 生成命令：openssl rand -hex 32
SESSION_SECRET=your_random_session_secret

# L13（生产必填）：/api/cron 定时任务的调用密钥。调用方须携带
# Authorization: Bearer <secret> 或 ?secret=<secret>；未配置时允许
# 匿名触发（仅做 5 分钟 1 次的限频），不建议生产使用。
# 生成命令：openssl rand -hex 32
CRON_SECRET=your_random_cron_secret

# 存储类型: localstorage | d1（redis、upstash 未实现，配置将报错）
# 与 wrangler.toml 默认值保持一致；Cloudflare Pages + D1 部署请改为 d1，
# 并按 D1初始化.md 建表、填 database_id。
NEXT_PUBLIC_STORAGE_TYPE=localstorage

# 密码加密密钥
PASSWORD_ENCRYPTION_KEY=your_encryption_key

# 搜索配置
NEXT_PUBLIC_SEARCH_MAX_PAGE=5

# 可选功能
NEXT_PUBLIC_IMAGE_PROXY=
NEXT_PUBLIC_DOUBAN_PROXY=
NEXT_PUBLIC_DISABLE_YELLOW_FILTER=false
NEXT_PUBLIC_ENABLE_REGISTER=false

# M3：仅当部署确认位于 Cloudflare 之后（CF 会覆盖 cf-connecting-ip 为
# 真实客户端 IP，伪造无效）或位于会覆盖该头的可信反代之后，才设为 true；
# 否则攻击者可伪造 X-Forwarded-For 轮换 IP 绕过登录限频。
# 默认不信任代理头，限频退化为全局共享桶（fail-closed）。
# TRUST_PROXY_HEADERS=true

# L14：auth Cookie 的 secure 属性。默认按请求协议自动决定（HTTPS 下
# secure，纯 HTTP 的局域网 Docker 部署下不 secure，否则浏览器拒绝设置
# Cookie、登录后仍跳回登录页）。仅在反代未透传 x-forwarded-proto 且
# 站点仅 HTTPS 可达时才需要显式设为 true。
# COOKIE_SECURE=true

# Upstash Redis（未实现，仅作占位，勿用）
# UPSTASH_URL=https://xxx.upstash.io
# UPSTASH_TOKEN=your_token
